from pyspark.sql.functions import *

# COMMAND ----------

def row_columns_count(df):
    return df.count(), len(df.columns)


# COMMAND ----------

def check_null_values(df,lst_cl):
    columns={}
    for i in lst_cl:
        columns[i]=df.filter(df[i].isNull()).count()
    return columns

# COMMAND ----------

def function(df):
    return display(df.limit(5))

# COMMAND ----------

def check_null_values_percentage(df,lst_cl):
    global missing_values_perc_more_than_75
    global missing_values_perc_less_than_75
    missing_values_perc_more_than_75={}
    missing_values_perc_less_than_75={}
    for i in lst_cl:
        a=df.filter(df[i].isNull()).count()
        b=df.count()
        c=round(a/b,2)*100
        if c>75:
            missing_values_perc_more_than_75[i]=c
        else:
            missing_values_perc_less_than_75[i]=c
    return ({"Missing_values_percentage_more_than_75":missing_values_perc_more_than_75,\
             "Missing_values_percentage_less_than_75":missing_values_perc_less_than_75})

# COMMAND ----------

def check_duplicates(df,cl):
    a=df.select(cl).count()
    b=df.count()
    if a==b:
        return "No duplicates"
    else:
        c=a-b
        return "there are "+c+"no of duplicates"

